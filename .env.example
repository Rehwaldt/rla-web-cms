# Local development (pnpm dev, the importer): copy to .env. The Hetzner server has its own
# settings in deploy/.env, see deploy/.env.example.

DATABASE_URL=postgresql://user:password@host/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# The website the edit view's Preview button opens documents on (its /go route). Empty: no button.
WEBSITE_URL=http://webserver/website_rla/1_php_payload

# Parent domain to share the login cookie with. Leave empty locally: the dev CMS (pc86) and the
# dev website (webserver) share no parent domain. Production sets it (deploy/.env.example).
COOKIE_DOMAIN=

# Legacy website CMS database (`web` on server02) — read-only source for the migration.
LEGACY_WEB_DB_HOST=your-mysql-server
LEGACY_WEB_DB_USER=your-mysql-user
LEGACY_WEB_DB_PASSWORD=your-mysql-password
LEGACY_WEB_DB_NAME=web

# Root folder of the legacy website files (0_img, 4_res).
LEGACY_WEB_FILES_ROOT=Z:/website/website_rla
