# Copy to deploy/.env on the server and fill in. Never commit the filled-in file.

# Domain the CMS is served on. Its A/AAAA records must point at the server.
CMS_DOMAIN=cms.rehwaldt.de

# Domain of the public website (Rehwaldt/rla-website), served by this stack's Caddy too.
# staging.rehwaldt.de until the cutover, then www.rehwaldt.de. Same DNS rule as above.
WEBSITE_DOMAIN=staging.rehwaldt.de

# Long random string: `openssl rand -hex 32`. Changing it later logs every user out.
PAYLOAD_SECRET=

# Database password: `openssl rand -hex 24` (hex, so it needs no escaping in the database URL).
# Only takes effect when the database volume is first created.
POSTGRES_PASSWORD=

# Host folder holding the uploads (owned by uid 1001, the app user in the container).
MEDIA_DIR=/srv/rla-cms/media

# Commit of the CMS image that runs. deploy.sh sets it on every deploy; leave it alone, except to
# roll back (see README.md).
CMS_TAG=
